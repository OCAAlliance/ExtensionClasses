{
    "type": "struct",
    "name": "Aes67StreamDescriptor",
    "comment": "Datatype of stream registry entries. Fields are essentially the relevant fields of OcaMediaStreamEndpoint, plus a few added items.",
    "properties": [
        {
            "name": "IDExternal",
            "type": "OcaBlob",
            "comment": "External ID of Endpoint."
        },
        {
            "name": "Addresses",
            "type": "OcaList<Aes67StreamTransportAddress>",
            "comment": "List of IP addresses and ports of all redundant paths of the stream."
        },
        {
            "name": "Direction",
            "type": "OcaIODirection",
            "comment": "Input or output stream direction."
        },
        {
            "name": "AlignmentLevel",
            "type": "OcaDBFS",
            "comment": "Alignment level of the stream endpoint. NaN if not known."
        },
        {
            "name": "StreamMode",
            "type": "OcaMediaStreamMode",
            "comment": "Stream Mode of the stream."
        },
        {
            "name": "SecurityType",
            "type": "OcaSecurityType",
            "comment": "Security type of the stream."
        },
        {
            "name": "StreamCastMode",
            "type": "OcaMediaStreamCastMode",
            "comment": "Unicast or multicast."
        },
        {
            "name": "AdaptationData",
            "type": "OcaTypedBlob<Aes67EndpointAdaptationData>",
            "comment": "AES70-21 Adaptation-specific data."
        },
        {
            "name": "SDPString",
            "type": "OcaSDPString",
            "comment": "SDP string, if available."
        },
        {
            "name": "SIPString",
            "type": "OcaString",
            "comment": "SIP string, if available."
        },
        {
            "name": "InfoSource",
            "type": "OcaBlob",
            "comment": "Identifier of source of data for this entry, if available."
        },
        {
            "name": "TimeStamp",
            "type": "OcaTime",
            "comment": "Time this entry created or last updated."
        }
    ]
}
