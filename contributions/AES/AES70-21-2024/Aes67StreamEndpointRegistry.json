                {
                    "name": "IDExternal",
                    "type": "OcaBlob",
                    "comment": "IDExternal value of entry to be deleted."
                }
            ],
            "return_values": []
        },
        {
            "id": { "level": 3, "index": 6 },
            "name": "AddRegistryEntriesFromSDP",
