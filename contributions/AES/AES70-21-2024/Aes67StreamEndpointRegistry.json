{
    "type": "control_class",
    "name": "Aes67StreamEndpointRegistry",
    "parent": "OcaAgent",
    "comment": "Stores a list of Stream Descriptors, each describing a Stream Endpoint that is a potential source or sink in the network. An instance associated via Aes67OcaMediaTransportApplication.StreamSourceRegistryONo implements the optional Stream Source Registry (SSR).",
    "classid": {
        "cid": "000B5E",
        "suffix": "2102"
    },
    "properties": [
        {
            "id": { "level": 3, "index": 1 },
            "name": "Registry",
            "type": "OcaList<Aes67StreamEndpointDescriptor>",
            "comment": "Registry entries."
        }
    ],
    "methods": [
        {
            "id": { "level": 3, "index": 1 },
            "name": "GetRegistry",
            "comment": "Gets the entire Registry.",
            "arguments": [],
            "return_values": [
                {
                    "name": "Registry",
                    "type": "OcaList<Aes67StreamEndpointDescriptor>"
                }
            ]
        },
        {
            "id": { "level": 3, "index": 2 },
            "name": "GetRegistryEntry",
            "comment": "Gets a Registry entry. Draft 261030 pseudocode omits the selector; IDExternal is used here for consistency with DeleteRegistryEntry.",
