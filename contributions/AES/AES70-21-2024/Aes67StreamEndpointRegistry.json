                    "name": "IDExternal",
                    "type": "OcaBlob",
                    "comment": "IDExternal value of the entry to return."
                }
            ],
            "return_values": [
                {
                    "name": "Entry",
                    "type": "Aes67StreamEndpointDescriptor"
                }
            ]
        },
        {
            "id": { "level": 3, "index": 3 },
            "name": "AddRegistryEntry",
            "comment": "Adds an entry to the Registry. Returns the resulting entry.",
            "arguments": [
                {
                    "name": "Entry",
                    "type": "Aes67StreamEndpointDescriptor"
                }
            ],
            "return_values": [
                {
                    "name": "Entry",
                    "type": "Aes67StreamEndpointDescriptor"
                }
            ]
        },
        {
            "id": { "level": 3, "index": 4 },
            "name": "SetRegistryEntry",
            "comment": "Modifies a Registry entry. Entry.IDExternal identifies the entry to modify.",
            "arguments": [
                {
                    "name": "Entry",
                    "type": "Aes67StreamEndpointDescriptor"
                }
            ],
            "return_values": []
        },
        {
            "id": { "level": 3, "index": 5 },
